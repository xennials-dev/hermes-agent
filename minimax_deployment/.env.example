# -------------------------------------------------------------
# MiniMax Deployment & Integration Environment Configuration
# -------------------------------------------------------------

# Hugging Face Access (Optional, for downloading gated or large weights)
HF_TOKEN=

# Directory Paths for Persistence
HF_CACHE_DIR=./data/hf-cache
MODEL_WEIGHTS_DIR=./data/models

# MiniMax-M3 / M2.7 Configuration
M3_MODEL_PATH=MiniMaxAI/MiniMax-M3-MXFP8
TP_SIZE=8
PORT_LLM=30000
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# MiniMax-H3 (Audiovisual Diffusion) Configuration
PORT_VIDEO=30010
H3_MODEL_DIR=./data/models/minimax-h3
H3_NUM_GPUS=8
H3_ULYSSES_DEGREE=8

# Client Settings (For minimax_client.py)
# If using the MiniMax Cloud API:
MINIMAX_API_KEY=your_minimax_api_key_here
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
OPENAI_BASE_URL=https://api.minimax.io/v1

# If connecting to your self-hosted SGLang instance:
# OPENAI_BASE_URL=http://localhost:30000/v1
